<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dtsc_checkoutline_cut_svg_tree" model="ir.ui.view">
        <field name="name">dtsc.checkoutline.cut.svg.tree</field>
        <field name="model">dtsc.checkoutline</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false" editable="bottom" default_order="sequence"
                  decoration-info="cut_svg_state == 'pending'"
                  decoration-success="cut_svg_state == 'done'"
                  decoration-danger="cut_svg_state == 'error'">
                <field name="sequence" readonly="1" string="項次"/>
                <field name="project_product_name" readonly="1" string="檔名"/>
                <field name="product_width" readonly="1" string="寬"/>
                <field name="product_height" readonly="1" string="高"/>
                <field name="multi_chose_ids" readonly="1" string="後加工"/>
                <field name="cut_source_image" widget="image" options="{'size': [64, 64]}" string="參考圖"/>
                <field name="cut_svg_state" readonly="1" string="狀態"/>
                <field name="cut_svg_mode" readonly="1" optional="hide"/>
                <field name="cut_svg_generated_at" readonly="1" optional="hide"/>
                <button name="action_generate_cut_svg"
                        type="object"
                        string="生成"
                        class="btn-primary"
                        attrs="{'invisible': [('cut_svg_state', '=', 'pending')]}"/>
                <field name="cut_svg_file" filename="cut_svg_filename" string="下載SVG"/>
                <field name="cut_svg_filename" invisible="1"/>
                <field name="cut_svg_error" readonly="1" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_dtsc_checkoutline_cut_svg_form" model="ir.ui.view">
        <field name="name">dtsc.checkoutline.cut.svg.form</field>
        <field name="model">dtsc.checkoutline</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="刀模項次">
                <sheet>
                    <group>
                        <group string="項次資訊">
                            <field name="sequence" readonly="1"/>
                            <field name="project_product_name" readonly="1"/>
                            <field name="product_width" readonly="1"/>
                            <field name="product_height" readonly="1"/>
                            <field name="multi_chose_ids" readonly="1"/>
                        </group>
                        <group string="生成狀態">
                            <field name="cut_svg_state" readonly="1"/>
                            <field name="cut_svg_mode" readonly="1"/>
                            <field name="cut_svg_generated_at" readonly="1"/>
                            <field name="cut_svg_error" readonly="1"/>
                        </group>
                    </group>
                    <group string="參考圖">
                        <field name="cut_source_image" widget="image" nolabel="1" colspan="2"/>
                    </group>
                    <group>
                        <button name="action_generate_cut_svg" type="object" string="生成刀模 SVG" class="btn-primary"
                                attrs="{'invisible': [('cut_svg_state', '=', 'pending')]}"/>
                        <field name="cut_svg_file" filename="cut_svg_filename"/>
                        <field name="cut_svg_filename" invisible="1"/>
                    </group>
                    <group string="生成結果預覽" col="1">
                        <field name="cut_svg_preview_html" nolabel="1" colspan="2"/>
                    </group>
                    <group string="解析 JSON" col="1">
                        <field name="cut_svg_json" nolabel="1" widget="text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
