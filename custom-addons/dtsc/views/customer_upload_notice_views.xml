<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dtsc_customer_upload_notice_search" model="ir.ui.view">
        <field name="name">dtsc.customer.upload.notice.search</field>
        <field name="model">dtsc.customer.upload.notice</field>
        <field name="arch" type="xml">
            <search string="客戶上傳通知">
                <field name="customer_name"/>
                <field name="order_name"/>
                <field name="filename"/>
                <filter string="待確認" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="已確認" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
            </search>
        </field>
    </record>

    <record id="view_dtsc_customer_upload_notice_tree" model="ir.ui.view">
        <field name="name">dtsc.customer.upload.notice.tree</field>
        <field name="model">dtsc.customer.upload.notice</field>
        <field name="arch" type="xml">
            <tree string="客戶上傳通知" create="0" edit="0" delete="0">
                <field name="create_date" string="通知時間"/>
                <field name="customer_name"/>
                <field name="order_name"/>
                <field name="filename"/>
                <field name="upload_source"/>
                <field name="state"/>
                <field name="confirmed_by"/>
                <field name="confirmed_at"/>
            </tree>
        </field>
    </record>

    <record id="view_dtsc_customer_upload_notice_form" model="ir.ui.view">
        <field name="name">dtsc.customer.upload.notice.form</field>
        <field name="model">dtsc.customer.upload.notice</field>
        <field name="arch" type="xml">
            <form string="客戶上傳通知" create="0" edit="0" delete="0">
                <header>
                    <button name="action_confirm"
                            type="object"
                            string="確認收到"
                            class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="customer_name"/>
                            <field name="partner_id"/>
                            <field name="order_name"/>
                            <field name="checkout_id"/>
                        </group>
                        <group>
                            <field name="filename"/>
                            <field name="upload_source"/>
                            <field name="create_date" string="通知時間"/>
                            <field name="confirmed_by"/>
                            <field name="confirmed_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="notify_user_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dtsc_customer_upload_notice_settings_form" model="ir.ui.view">
        <field name="name">dtsc.customer.upload.notice.settings.form</field>
        <field name="model">dtsc.customer.upload.notice.settings</field>
        <field name="arch" type="xml">
            <form string="客戶上傳通知設置">
                <sheet>
                    <group>
                        <field name="notify_group_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="選擇群組，例如：base、業務、美工…"/>
                    </group>
                    <div class="text-muted">
                        依「大圖」權限群組名稱選擇誰會在頂部小鈴鐺收到客戶上傳通知，可多選。
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply"
                            type="object"
                            string="保存"
                            class="btn-primary"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dtsc_customer_upload_notice" model="ir.actions.act_window">
        <field name="name">客戶上傳通知記錄</field>
        <field name="res_model">dtsc.customer.upload.notice</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="action_dtsc_customer_upload_notice_settings" model="ir.actions.act_window">
        <field name="name">客戶上傳通知設置</field>
        <field name="res_model">dtsc.customer.upload.notice.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_dtsc_customer_upload_notice_settings"
              name="客戶上傳通知設置"
              parent="dtsc.menu_setting"
              action="action_dtsc_customer_upload_notice_settings"
              sequence="171"
              groups="dtsc.group_dtsc_gly,dtsc.group_dtsc_mg"/>

    <menuitem id="menu_dtsc_customer_upload_notice"
              name="客戶上傳通知記錄"
              parent="dtsc.menu_setting"
              action="action_dtsc_customer_upload_notice"
              sequence="172"
              groups="dtsc.group_dtsc_bs,dtsc.group_dtsc_gly,dtsc.group_dtsc_mg"/>
</odoo>
