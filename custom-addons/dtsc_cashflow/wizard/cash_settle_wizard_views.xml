<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dtsc_cash_settle_wizard_form" model="ir.ui.view">
        <field name="name">dtsc.cash.settle.wizard.form</field>
        <field name="model">dtsc.cash.settle.wizard</field>
        <field name="arch" type="xml">
            <form string="金流結清">
                <group>
                    <field name="move_id"/>
                    <field name="move_type" invisible="1"/>
                    <field name="amount_total"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="bank_id"/>
                    <field name="operator_id"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="確認" class="btn-primary"/>
                    <button string="取消" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
