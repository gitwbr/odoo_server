<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_cashflow" model="ir.ui.view">
        <field name="name">account.move.form.cashflow</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_cash_settle_wizard" type="object"
                        string="標記已收"
                        class="oe_highlight"
                        groups="dtsc.group_dtsc_gly,dtsc.group_dtsc_kj"
                        attrs="{'invisible': ['|', ('move_type', '!=', 'out_invoice'), ('cash_settle_state', '=', 'done')]}"/>
                <button name="action_open_cash_settle_wizard" type="object"
                        string="標記已付"
                        class="oe_highlight"
                        groups="dtsc.group_dtsc_gly,dtsc.group_dtsc_kj"
                        attrs="{'invisible': ['|', ('move_type', '!=', 'in_invoice'), ('cash_settle_state', '=', 'done')]}"/>
                <button name="action_cash_unsettle" type="object"
                        string="取消結清"
                        groups="dtsc.group_dtsc_gly,dtsc.group_dtsc_kj"
                        attrs="{'invisible': [('cash_settle_state', '!=', 'done')]}"
                        confirm="確定取消金流結清並沖銷銀行流水？"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="金流結清" groups="dtsc.group_dtsc_gly,dtsc.group_dtsc_kj"
                       attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'in_invoice'))]}">
                    <group>
                        <field name="cash_settle_label" readonly="1"/>
                        <field name="cash_settle_state" invisible="1"/>
                        <field name="cash_bank_id" readonly="1"/>
                        <field name="cash_operator_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="cash_settle_date" readonly="1"/>
                        <field name="cash_note" readonly="1"/>
                        <field name="cash_transaction_id" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_cashflow" model="ir.ui.view">
        <field name="name">account.move.tree.cashflow</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="cash_settle_label" optional="show"
                         groups="dtsc.group_dtsc_gly,dtsc.group_dtsc_kj"/>
                <field name="cash_bank_id" optional="hide"
                         groups="dtsc.group_dtsc_gly,dtsc.group_dtsc_kj"/>
            </xpath>
        </field>
    </record>
</odoo>
