<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_cashflow_overdue_line_notify" model="ir.cron">
        <field name="name">金流：到期未收/未付 LINE 提醒</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model.cron_cashflow_overdue_line_notify()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall">False</field>
        <!-- 每天早上 09:00（UTC+8 ≈ 01:00 UTC） -->
        <field name="nextcall" eval="(DateTime.now().replace(hour=1, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
