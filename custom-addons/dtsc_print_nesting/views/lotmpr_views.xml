<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lotmpr_form_print_nesting" model="ir.ui.view">
        <field name="name">dtsc.lotmpr.form.print.nesting</field>
        <field name="model">dtsc.lotmpr</field>
        <field name="inherit_id" ref="dtsc.view_lotmpr_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lotmprline_id']" position="after">
                <group string="印刷排版" col="1">
                    <field name="print_roll_ids" invisible="1"/>
                    <field name="print_preview_html" nolabel="1" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='lotmprline_id']/tree" position="inside">
                <field name="print_order_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
