{
  "checkout_count": {
    "model": "dtsc.checkout",
    "label": "有效大圖訂單進單數",
    "aliases": [
      "large format order",
      "large format printing order",
      "大圖訂單",
      "大图订单",
      "進單數",
      "进单数"
    ],
    "date_field": "create_date",
    "filters": [
      {
        "field": "is_invisible",
        "operator": "eq",
        "value": false
      },
      {
        "field": "checkout_order_state",
        "operator": "not_in",
        "value": ["cancel", "waiting_confirmation"]
      }
    ],
    "basis": "按建立時間計 A/F/E/M 等大圖主選單母單；排除作廢、隱藏與 CRM 待確認，M 保留，非產品行數。待確認不計入大圖訂單。"
  },
  "checkout_tax_total": {
    "model": "dtsc.checkout",
    "label": "大圖訂單含稅金額合計（稅後總價）",
    "aliases": [
      "含稅金額",
      "含税金额",
      "含稅總價",
      "含税总价",
      "稅後總價",
      "税后总价",
      "大圖訂單金額",
      "大图订单金额",
      "訂單含稅",
      "订单含税",
      "tax inclusive total",
      "order amount with tax"
    ],
    "date_field": "create_date",
    "filters": [
      {
        "field": "is_invisible",
        "operator": "eq",
        "value": false
      },
      {
        "field": "checkout_order_state",
        "operator": "not_in",
        "value": ["cancel", "waiting_confirmation"]
      }
    ],
    "measures": [
      {
        "field": "total_price_added_tax",
        "aggregate": "sum",
        "alias": "tax_inclusive_total"
      }
    ],
    "unit": "金額",
    "basis": "按進單日合計大圖主選單口徑母單的 total_price_added_tax（界面名稅後總價）；排除作廢、隱藏與 CRM 待確認。用戶說含稅金額/含稅總價即此欄。與應收 account.move.total_price 不同。同次回傳的 record_count 為同口徑單數。"
  },
  "checkout_unshipped": {
    "model": "dtsc.checkout",
    "label": "大圖訂單尚未出貨數",
    "date_field": "create_date",
    "filters": [
      {"field": "is_delivery", "operator": "eq", "value": false},
      {"field": "is_invisible", "operator": "eq", "value": false},
      {"field": "checkout_order_state", "operator": "not_in", "value": ["cancel", "closed", "waiting_confirmation"]}
    ],
    "basis": "尚未出貨且未作廢/結案/待確認/隱藏，不限是否逾期。今天預計出貨須另外篩選 estimated_date 的今天起訖，不可使用逾期條件。"
  },
  "checkout_overdue": {
    "model": "dtsc.checkout",
    "label": "大圖訂單逾期未出貨（預計發貨時間早於現在）",
    "aliases": [
      "逾期",
      "逾期訂單",
      "逾期订单",
      "逾期未出貨",
      "逾期未出货",
      "超期未出貨",
      "超期未出货"
    ],
    "date_field": "create_date",
    "filters": [
      {
        "field": "is_delivery",
        "operator": "eq",
        "value": false
      },
      {
        "field": "is_invisible",
        "operator": "eq",
        "value": false
      },
      {
        "field": "checkout_order_state",
        "operator": "not_in",
        "value": [
          "cancel",
          "closed",
          "waiting_confirmation"
        ]
      }
    ],
    "due_field": "estimated_date",
    "detail_fields": [
      "name",
      "estimated_date",
      "customer_id",
      "checkout_order_state",
      "create_date"
    ],
    "basis": "沿用概覽 _get_delivery_risk_items：未出貨、未隱藏、未作廢/結案/待確認，預計發貨時間早於查詢時刻。期間按母單建立日期。列明細時必須含 estimated_date（發貨日期），不能只列進單日。待確認（CRM 草稿）與大圖主選單一致，不計入逾期。"
  },
  "b_open": {
    "model": "dtsc.makein",
    "label": "B 內部工單未完成數",
