    "date_field": "create_date",
    "filters": [
      {
        "field": "is_invisible",
        "operator": "eq",
        "value": false
      },
      {
        "field": "checkout_order_state",
        "operator": "not_in",
        "value": ["cancel", "waiting_confirmation"]
      },
      {
        "field": "checkout_order_type",
        "operator": "eq",
        "value": "a"
      }
    ],
    "basis": "大圖主選單口徑下 checkout_order_type=a 的普通進單數；與重製 E 單比較時用此為 A 側筆數。不是工單。"
  },
