      "生产机台用量",
      "top machines",
      "machine usage"
    ],
    "date_field": "checkout_product_id.create_date",
    "group_by": ["machine_id"],
    "order": [{"field": "units_total", "direction": "desc"}],
    "limit": 5,
    "filters": [
      {
        "field": "checkout_product_id.is_invisible",
