        "value": false
      },
      {
        "field": "checkout_product_id.checkout_order_state",
        "operator": "not_in",
        "value": ["cancel", "waiting_confirmation"]
      },
      {
        "field": "machine_id",
        "operator": "ne",
        "value": false
      }
    ],
    "measures": [
      {
        "field": "total_units",
        "aggregate": "sum",
        "alias": "units_total"
      },
