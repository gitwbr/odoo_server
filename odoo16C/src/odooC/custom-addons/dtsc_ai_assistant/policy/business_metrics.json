    "basis": "按母單進單日對大圖訂單明細按商品名稱 product_id 分組，加總總才數 total_units（預設排序依據）；同時回傳行金額合計 price 供對照。排除作廢、隱藏與 CRM 待確認。預設才數降序前 10。禁止只列明細行或把 ID 當銷量；不是採購用產品、也不是標準 sale.order。"
  },
  "purchase_product_spend": {
    "model": "purchase.order.line",
    "label": "採購產品金額排行（按採購明細）",
    "aliases": [
      "採購最多",
      "采购最多",
      "採購最好",
      "采购最好",
      "採購產品排行",
      "采购产品排行",
      "採購材料",
      "采购材料",
      "買得最多",
      "买得最多",
      "進貨最多",
      "进货最多",
      "top purchased product"
    ],
    "date_field": "order_id.date_order",
    "group_by": ["product_id", "currency_id"],
    "order": [{"field": "purchase_amount", "direction": "desc"}],
    "limit": 10,
    "filters": [
      {
        "field": "order_id.state",
        "operator": "in",
        "value": ["purchase", "done"]
      }
    ],
    "measures": [
      {
        "field": "price_total",
        "aggregate": "sum",
        "alias": "purchase_amount"
      }
    ],
    "unit": "金額",
    "basis": "來源是採購訂單明細 purchase.order.line（母單 purchase.order）；按母單訂單日 order_id.date_order，已確認/完成（state in purchase/done）分組加總 price_total。產品為 product.product。不含供應商欄；問供應商用 purchase_product_supplier_spend 或同口徑再按 partner_id 分組。"
  },
  "purchase_product_supplier_spend": {
    "model": "purchase.order.line",
    "label": "採購產品×供應商金額排行",
    "aliases": [
      "採購供應商",
      "采购供应商",
      "材料供應商",
      "材料供应商",
      "誰供應",
      "谁供应",
      "供應商是誰",
      "供应商是谁",
      "跟哪家買",
      "跟哪家买",
      "purchase supplier"
    ],
    "date_field": "order_id.date_order",
    "group_by": ["product_id", "partner_id", "currency_id"],
    "order": [{"field": "purchase_amount", "direction": "desc"}],
    "limit": 15,
    "filters": [
      {
        "field": "order_id.state",
        "operator": "in",
        "value": ["purchase", "done"]
      }
    ],
    "measures": [
      {
        "field": "price_total",
        "aggregate": "sum",
        "alias": "purchase_amount"
      }
    ],
    "unit": "金額",
    "basis": "同一採購明細口徑，按商品 product_id + 供應商 partner_id（= 採購單 purchase.order.partner_id，存於明細）分組加總 price_total。用戶同時問「採購最多的材料＋供應商是誰」時：先用 purchase_product_spend 定材料，再用本指標或同口徑 filters 限定該 product_id 按 partner_id 列出供應商；也可直接用本指標報該材料金額最高的供應商。禁止說採購單沒有供應商。"
  },
  "purchase_confirmed": {
    "model": "purchase.order",
    "label": "已確認採購單數",
    "date_field": "date_order",
    "filters": [
      {"field": "my_state", "operator": "in", "value": ["2", "3", "4"]},
      {"field": "state", "operator": "ne", "value": "cancel"}
    ],
    "basis": "依 DTSC 採購流程計待收貨、未轉應付、已轉應付單據；排除詢價單與作廢。期間按訂單日期，不是建立日期。"
  },
  "purchase_pending_receipt": {
    "model": "purchase.order",
    "label": "待收貨採購單數",
    "date_field": "date_order",
    "filters": [
      {"field": "my_state", "operator": "eq", "value": "2"},
      {"field": "state", "operator": "ne", "value": "cancel"}
    ],
    "basis": "沿用概覽待收貨採購口徑：DTSC 自訂狀態為待收貨。標準收貨進度 receipt_status 是另一欄位，不能代替此狀態。"
  },
  "receivable_open": {
    "model": "account.move",
    "label": "未結清客戶發票數",
    "date_field": "invoice_date",
    "filters": [
      {
        "field": "move_type",
        "operator": "eq",
        "value": "out_invoice"
      },
      {
        "field": "state",
        "operator": "eq",
        "value": "posted"
      },
      {
        "field": "amount_residual",
        "operator": "gt",
        "value": 0
      }
    ],
    "basis": "按發票日期計已過帳且剩餘應付/應收金額大於0的原始帳單筆數，不是金額、帳齡或現金流。"
  },
  "payable_open": {
    "model": "account.move",
    "label": "未結清供應商帳單數",
    "date_field": "invoice_date",
    "filters": [
      {
        "field": "move_type",
        "operator": "eq",
        "value": "in_invoice"
      },
      {
        "field": "state",
        "operator": "eq",
        "value": "posted"
      },
      {
        "field": "amount_residual",
        "operator": "gt",
        "value": 0
      }
    ],
    "basis": "按發票日期計已過帳且剩餘應付/應收金額大於0的原始帳單筆數，不是金額、帳齡或現金流。"
  },
  "s_pending": {
    "model": "dtsc.deliveryorder",
    "label": "S 出貨單草稿數",
    "date_field": "create_date",
    "filters": [
      {
        "field": "install_state",
        "operator": "eq",
        "value": "draft"
      }
    ],
    "basis": "S 狀態為草稿；已發送不等於物流已簽收。按 S 建立日期。"
  },
  "s_overdue": {
    "model": "dtsc.deliveryorder",
    "label": "S 出貨單草稿且交貨時間已過",
    "date_field": "create_date",
    "filters": [
      {
        "field": "install_state",
        "operator": "eq",
        "value": "draft"
      }
    ],
    "basis": "明確操作口徑：草稿 S 的交貨時間早於查詢時刻；非大圖订单逾期，也不代表物流逾期。列明細時必須含 delivery_date。",
    "due_field": "delivery_date",
    "detail_fields": [
      "name",
      "delivery_date",
      "install_state",
      "create_date"
    ]
  }
}
