  },
  "checkout_kaidan_rank": {
    "model": "dtsc.checkout",
    "label": "大圖訂單開單人員排行（才數與稅後總價）",
    "aliases": [
      "開單人員",
      "开单人员",
      "開單最多",
      "开单最多",
      "開單最多的人",
      "开单最多的人",
      "誰開單最多",
      "谁开单最多",
      "開單排行",
      "开单排行",
      "業務開單",
      "业务开单",
      "kaidan"
    ],
    "date_field": "create_date",
    "group_by": ["kaidan"],
    "order": [{"field": "tax_inclusive_total", "direction": "desc"}],
    "limit": 10,
    "filters": [
      {
        "field": "is_invisible",
        "operator": "eq",
        "value": false
      },
      {
        "field": "checkout_order_state",
        "operator": "not_in",
        "value": ["cancel", "waiting_confirmation"]
      },
      {
        "field": "kaidan",
        "operator": "ne",
        "value": false
      }
    ],
    "measures": [
      {
        "field": "unit_all",
        "aggregate": "sum",
        "alias": "units_total"
      },
      {
        "field": "total_price_added_tax",
        "aggregate": "sum",
        "alias": "tax_inclusive_total"
      }
    ],
    "unit": "金額",
    "basis": "按大圖訂單開單人員 kaidan（界面名開單人員，dtsc.userlistbefore）分組；同時合計總才數 unit_all 與稅後總價 total_price_added_tax。預設按稅後總價降序前 10，groups.record_count 為開單筆數。不是銷售人員 user_id，也不是 create_uid。用戶要比才數時看 units_total 排序結果或說明才數維度。"
  },
  "checkout_machine_usage": {
    "model": "dtsc.checkoutline",
    "label": "大圖訂單機台用量排行（按總才數）",
